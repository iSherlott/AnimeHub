generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ANIME_HUB_DATABASE_URL")
}

/// Conta opcional — navegar pelo catálogo/calendário/descobrir nunca exige
/// login. Só dados vinculados a uma pessoa (lista pessoal, favoritos,
/// comentários) exigem sessão ativa.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  passwordSalt String
  /// Nome de exibição (não precisa ser único) — mostrado no cabeçalho e em
  /// qualquer conteúdo público que a pessoa publicar (ex.: comentários).
  displayName  String
  avatarUrl    String?
  /// @identificador público e único (minúsculas; ver src/lib/handle.ts).
  /// Opcional até a pessoa escolher o seu.
  handle       String?   @unique
  /// Bio curta e opcional (Epic 28) — texto livre, sem markdown/formatação.
  bio          String?
  /// "ADMIN" | "MEMBER". A primeira conta criada no sistema vira admin
  /// automaticamente (mesmo bootstrap que já herda os dados órfãos).
  role         String    @default("MEMBER")
  /// Preferências da conta (Configurações, Figma `8:3333`/`13:42966`).
  /// titleFormat: "ja" (Japonês) | "romaji" | null (usa o padrão do produto).
  titleFormat  String?
  /// IANA (ex.: "America/Sao_Paulo"), "device" ou null (padrão do produto).
  timeZone     String?
  notifyReleases  Boolean  @default(true)
  notifyReplies   Boolean  @default(true)
  notifyComments  Boolean  @default(true)
  notifyFollowers Boolean  @default(true)
  notifyLikes     Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  socialReceived   SocialNotification[] @relation("SocialReceived")
  socialSent       SocialNotification[] @relation("SocialSent")
  sessions         Session[]
  animeList        Anime[]
  invitesCreated   Invite[]        @relation("InvitesCreated")
  inviteUsed       Invite?         @relation("InviteUsed")
  airingAlerts     AiringAlert[]
  comments         Comment[]
  commentReports   CommentReport[] @relation("CommentReporter")
  reportsResolved  CommentReport[] @relation("CommentResolver")
  posts               Post[]
  postLikes           PostLike[]
  postComments        PostComment[]
  postReports         PostReport[] @relation("PostReporter")
  postCommentReports        PostCommentReport[] @relation("PostCommentReporter")
  postCommentReportsResolved PostCommentReport[] @relation("PostCommentResolver")
  userReportsMade           UserReport[]        @relation("UserReporter")
  userReportsReceived       UserReport[]        @relation("UserReported")
  userReportsResolved       UserReport[]        @relation("UserReportResolver")
  postReportsResolved PostReport[] @relation("PostResolver")
  following           Follow[]     @relation("Following")
  followers           Follow[]     @relation("Followers")
  postCommentReplyTargets PostComment[] @relation("CommentReplyTo")
  blocksMade          Block[]      @relation("Blocker")
  blocksReceived      Block[]      @relation("Blocked")

  @@index([email])
}

/// Cadastro é só por convite — só um administrador pode gerar um. Cada
/// código vale pra uma única conta.
model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  createdBy String
  creator   User      @relation("InvitesCreated", fields: [createdBy], references: [id], onDelete: Cascade)
  usedById  String?   @unique
  usedBy    User?     @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdBy])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Anime {
  id              String    @id @default(cuid())
  /// Dono da lista — opcional só durante a migração de dados pré-contas;
  /// toda entrada nova é criada já vinculada ao usuário autenticado.
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Não são @unique globalmente — cada usuário tem sua própria lista, então
  /// dois usuários diferentes podem (e vão) acompanhar o mesmo anime, cada
  /// um com sua própria linha. A unicidade é por usuário (@@unique abaixo).
  anilistId       Int
  kitsuId         Int?
  malId           Int?
  shikimoriId     Int?
  /// ID numérico na AniDB (ex.: 15617). Preenchido manualmente — a busca por
  /// título exigiria baixar o dump anime-titles.xml.gz do domínio principal,
  /// que bloqueia o ambiente onde este projeto roda. Ache o ID na URL da
  /// página do anime em anidb.net.
  anidbId         Int?
  /// Nota média (0-10) vinda da AniDB — comunidade diferente da do MAL.
  anidbRating     Float?
  anidbVotes      Int?
  /// Nota média da comunidade AniList, 0-100 (escala nativa deles). Vem
  /// automaticamente em toda busca/refresh — ao contrário da nota da AniDB,
  /// não depende de vincular manualmente nenhum ID.
  averageScore    Int?
  /// Prêmios recebidos, separados por vírgula (só a AniDB rastreia isso).
  anidbAwards     String?
  /// Links pra outros bancos de dados (MAL, ANN, Wikipedia EN/JP, site
  /// oficial), como JSON {label: url}. Vem do bloco <resources> da AniDB.
  anidbResources  String?
  /// Todos os títulos por idioma que a AniDB conhece (é a fonte mais
  /// completa nisso — às vezes tem até título oficial em português), como
  /// JSON [{language, title, isOfficial}]. Alimenta a lista "Outros títulos".
  anidbTitles     String?
  lastRefreshedAt DateTime?
  titleRomaji     String
  titleEnglish    String?
  titleNative     String?
  /// Título em português — não existe fonte gratuita confiável pra isso,
  /// então é preenchido manualmente pelo usuário (ver TitleEditor).
  titlePortuguese String?
  /// Cache do HTML <ruby>/<rt> gerado a partir de titleNative (kuroshiro +
  /// kuromoji) — evita re-tokenizar toda vez que a página carrega.
  titleFurigana   String?
  coverImage      String?
  bannerImage     String?
  /// Link do site oficial, vindo do externalLinks da AniList (site ===
  /// "Official Site"). Ao contrário dos links de anidbResources, não exige
  /// vincular um anidbId manualmente — vem automático pra qualquer anime.
  officialSite    String?
  /// Trailer do YouTube vindo da AniList (campo `trailer`). Só o id do
  /// vídeo + o site — se não for "youtube" (raro), não tem como embutir e o
  /// campo fica sem uso na UI.
  trailerId       String?
  trailerSite     String?
  /// Elenco de dublagem (Epic 14) — JSON [{role, name, image, voiceActors:
  /// [{name, image, language}]}], todas as línguas de dublagem que a
  /// AniList conhece de uma vez, pra trocar de idioma no cliente sem nova
  /// requisição. Mesmo padrão já usado por anidbTitles/anidbResources —
  /// não precisa de tabela própria.
  castJson        String?
  /// Recomendações da AniList (Epic 14) — JSON [{anilistId, titleRomaji,
  /// titleEnglish, coverImage}]. Resolvidas contra a lista do próprio
  /// usuário na hora de renderizar (não aqui), pra linkar internamente
  /// quando o anime recomendado já estiver na lista.
  recommendationsJson String?
  /// Cor de destaque extraída da capa/banner (ver src/lib/accentColor.ts),
  /// recalculada a cada refresh — usada como tonalidade de fundo na página
  /// de detalhe e no hero da home.
  accentColor     String?
  description     String?
  /// Descrição em português — igual titlePortuguese, sem fonte gratuita
  /// confiável pra tradução automática, então é preenchida manualmente pelo
  /// usuário (ver DescriptionEditor). Exibida no lugar de `description`
  /// quando a preferência de idioma do título estiver em "pt".
  descriptionPortuguese String?
  episodes        Int?
  /// TV / MOVIE / OVA / ONA / SPECIAL / MUSIC — vem da AniList (format) ou
  /// do Type da AniDB.
  format          String?
  status          String?
  season          String?
  seasonYear      Int?
  genres          String?
  seriesKey       String?
  seasonNumber    Int       @default(1)
  /// Curadoria manual do usuário — alimenta o hero rotativo da home
  /// (ver HeroBannerRotator). Não tem relação com WatchStatus.
  isFavorite      Boolean   @default(false)
  /// Marcado quando isFavorite vira true, limpo quando vira false — define
  /// a ordem do hero rotativo sem ser afetado por outros updatedAt (título,
  /// refresh, etc.) que não têm nada a ver com favoritar.
  favoritedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  platformLinks PlatformLink[]
  progress      WatchProgress?
  episodeList   Episode[]

  @@unique([userId, anilistId])
  @@unique([userId, kitsuId])
  @@index([seriesKey])
  @@index([userId])
  @@index([userId, isFavorite])
}

/**
 * Franquia canônica (D-18, aprovada) — agrupa as produções (temporadas,
 * filmes, OVAs) de uma mesma obra, derivada das `relations` da AniList
 * (src/lib/franchise.ts), NÃO do título. Compartilhada por todos os usuários.
 */
model Franchise {
  id            String       @id @default(cuid())
  /// anilistId da produção mais antiga da cadeia PREQUEL/PARENT.
  rootAnilistId Int          @unique
  name          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  productions   Production[]
}

/**
 * Produção canônica (D-18/D-03) — uma entrada de catálogo (temporada,
 * filme, OVA…) compartilhada por todos: base do detalhe público de obra.
 * Metadados vivem aqui UMA vez; o estado pessoal (acompanhar, favorito,
 * overrides) continua em `Anime` por usuário até a fatia F4.
 */
model Production {
  id           String    @id @default(cuid())
  anilistId    Int       @unique
  franchiseId  String
  franchise    Franchise @relation(fields: [franchiseId], references: [id], onDelete: Restrict)
  /// 1 + temporadas (TV/TV_SHORT) anteriores na cadeia da franquia.
  seasonNumber Int       @default(1)
  /// TV / TV_SHORT / MOVIE / OVA / ONA / SPECIAL / MUSIC (formato AniList).
  format       String?
  titleRomaji  String
  titleEnglish String?
  titleNative  String?
  coverImage   String?
  bannerImage  String?
  description  String?
  episodes     Int?
  status       String?
  season       String?
  seasonYear   Int?
  genres       String?
  officialSite String?
  /// JSON [{id, titleRomaji, format, relationType}] — relações da AniList (sequências, spin-offs…).
  relationsJson String?
  createdAt    DateTime  @default(now())
  fetchedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([franchiseId])
}

/**
 * Registro de execuções dos serviços de dados (calendar-loader, notifier…):
 * base do painel Admin → Execuções (ADMIN-003/004). Retenção curta.
 */
model IngestionRun {
  id             String   @id @default(cuid())
  /// "calendar-loader" | "notifier" | ...
  source         String
  startedAt      DateTime
  finishedAt     DateTime
  /// "OK" | "PARTIAL" | "ERROR"
  status         String
  itemsProcessed Int      @default(0)
  itemsFailed    Int      @default(0)
  message        String?

  @@index([source, startedAt])
}

/**
 * Bloqueio de perfil (D-10): bidirecional para visibilidade e interação
 * (ver src/lib/blocks.ts). Bloquear também desfaz o seguir nos dois sentidos.
 */
/**
 * Hashtag canônica (D-13; Figma `13:42068`): `key` é o ID canônico
 * (NFKC + minúsculas), `display` o nome da 1ª ocorrência. Não associa o post
 * a nenhum anime.
 */
model Hashtag {
  id        String        @id @default(cuid())
  key       String        @unique
  display   String
  /// WORK | SEASON | GENRE | TOPIC (ver src/lib/hashtags.ts#classifyHashtag).
  kind      String        @default("TOPIC")
  createdAt DateTime      @default(now())
  posts     PostHashtag[]
}

model PostHashtag {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, hashtagId])
  @@index([hashtagId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Episode {
  id            String    @id @default(cuid())
  animeId       String
  anime         Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  number        Int
  /// Temporada/cour dentro do próprio anime (ex.: One Piece tem 1 entrada
  /// só na Kitsu com centenas de episódios espalhados em várias
  /// "seasonNumber") — usado pra agrupar a grade de episódios por
  /// temporada. Diferente do seasonNumber do Anime (que separa franquias
  /// em entradas de catálogo distintas).
  seasonNumber  Int       @default(1)
  titleRomaji   String?
  /// Adicionado no Epic 2 — sem isso, a grade de episódios não tinha nada
  /// pra mostrar quando a preferência de idioma era "inglês", diferente do
  /// título do anime (que sempre tem titleEnglish vindo da AniList).
  titleEnglish  String?
  titleJapanese String?
  /// Sinopse curta do episódio — a Kitsu expõe isso no mesmo padrão do
  /// `synopsis` que já é capturado no nível do anime (KitsuAnimeMatch),
  /// só que por episódio. Usada na lista de episódios (redesenho inspirado
  /// em sites de streaming — grade de cards sem contexto nenhum virou uma
  /// lista com resumo por episódio).
  synopsis      String?
  thumbnail     String?
  airDate       DateTime?
  createdAt     DateTime  @default(now())

  /// seasonNumber entra na chave (não só number sozinho): o número reinicia
  /// a cada temporada dentro do mesmo anime (ver comentário acima), então
  /// S1E1 e S2E1 são episódios distintos e legítimos, não um conflito.
  @@unique([animeId, seasonNumber, number])
}

model PlatformLink {
  id        String   @id @default(cuid())
  animeId   String
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  createdAt DateTime @default(now())

  @@unique([animeId, platform])
}

/**
 * Comentário por anime (Epic 15) — chave por anilistId, não por Anime.id:
 * cada usuário tem sua própria linha de Anime por anilistId (isolamento do
 * Epic 11), então o comentário precisa aparecer pra qualquer um que tenha
 * esse mesmo anime na lista, não só pra quem comentou.
 */
model Comment {
  id        String    @id @default(cuid())
  anilistId Int
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  /// Soft delete (pelo autor ou por um admin via fila de denúncia) — mantém
  /// o histórico de CommentReport íntegro em vez de um hard-delete que
  /// quebraria a referência.
  deletedAt DateTime?

  reports CommentReport[]

  @@index([anilistId])
  @@index([userId])
}

/**
 * Denúncia de comentário (Epic 15) — fila que o administrador revisa;
 * denunciar não remove o comentário automaticamente.
 */
model CommentReport {
  id           String    @id @default(cuid())
  commentId    String
  comment      Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("CommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([commentId, reporterId])
  @@index([commentId])
}

/**
 * Cache do catálogo "Descobrir" — animes que ainda podem não estar na sua
 * lista. Guardamos o que a AniList/Kitsu já nos deram (imagens, datas de
 * início/fim, nº de episódios, previsão do próximo episódio) para a tela de
 * Descobrir continuar funcionando mesmo se essas APIs ficarem fora do ar.
 */
model CatalogEntry {
  id                String    @id @default(cuid())
  anilistId         Int?      @unique
  kitsuId           Int?      @unique
  titleRomaji       String
  titleEnglish      String?
  titleNative       String?
  coverImage        String?
  bannerImage       String?
  description       String?
  episodes          Int?
  status            String?
  season            String?
  seasonYear        Int?
  genres            String?
  /// Nota média da comunidade AniList, 0-100 (escala nativa deles) — só
  /// disponível pra entradas vindas dessa fonte (source: "anilist").
  averageScore      Int?
  startDate         DateTime?
  endDate           DateTime?
  nextEpisodeNumber Int?
  nextEpisodeAt     DateTime?
  /// Posição no ranking de popularidade de quando foi buscado (1 = mais
  /// popular). Vem do sort by popularity da AniList ou do /trending da
  /// Kitsu — alimenta a fileira "Em alta" do Descobrir.
  popularityRank    Int?
  source            String
  fetchedAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([season, seasonYear])
}

/**
 * Cache do calendário de lançamentos — episódios com data/hora de exibição
 * confirmada pela AniList (AiringSchedule). É o equivalente legítimo (via
 * API pública) ao "simulcast calendar" da Crunchyroll: não fazemos scraping
 * do site deles nem do AniDB (ambos proíbem isso nos termos de uso e têm
 * proteção antibot) — a AniList expõe exatamente esse dado por API aberta.
 */
model AiringScheduleEntry {
  id           String   @id @default(cuid())
  anilistId    Int
  episode      Int
  airingAt     DateTime
  titleRomaji  String
  titleEnglish String?
  titleNative  String?
  coverImage   String?
  bannerImage  String?
  genres       String?
  /// Sinopse (Epic 29) — pedida na mesma busca AniList que popula o
  /// resto da linha (services/calendar-loader), pra dar pro preview do
  /// calendário mostrar sinopse mesmo de anime fora da lista do viewer.
  description  String?
  fetchedAt    DateTime @default(now())

  @@unique([anilistId, episode])
  @@index([airingAt])
}

model WatchProgress {
  id              String    @id @default(cuid())
  animeId         String    @unique
  anime           Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  status          String    @default("PLAN_TO_WATCH")
  episodeProgress Int       @default(0)
  score           Int?
  notes           String?
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

/**
 * Alerta de "favorito no ar agora" (Epic 10) — escrito só pelo serviço
 * `services/notifier` (a cada ~2min, junção de Anime x AiringScheduleEntry
 * por anilistId dentro de uma janela de exibição). O BFF só lê esta tabela
 * (GET /api/notifications) e marca `seenAt` quando a pessoa vê o alerta.
 */
model AiringAlert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId Int
  episode   Int
  airingAt  DateTime
  seenAt    DateTime?
  /// Horário anterior quando a data do episódio MUDOU depois do alerta
  /// ("Data alterada", Figma 13:43025); null = alerta de lançamento normal.
  previousAiringAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, anilistId, episode])
  @@index([userId, seenAt])
}

/**
 * Notificação SOCIAL (canal separado de "Lançamentos"): resposta à
 * publicação, resposta ao comentário, novo seguidor, curtida (OFF por
 * padrão). Guarda só QUEM e ONDE — nunca texto do conteúdo (spoiler-safe).
 */
model SocialNotification {
  id        String    @id @default(cuid())
  /// Quem recebe.
  userId    String
  user      User      @relation("SocialReceived", fields: [userId], references: [id], onDelete: Cascade)
  /// Quem fez a ação.
  actorId   String
  actor     User      @relation("SocialSent", fields: [actorId], references: [id], onDelete: Cascade)
  /// "POST_REPLY" | "COMMENT_REPLY" | "NEW_FOLLOWER" | "POST_LIKE"
  type      String
  postId    String?
  commentId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/**
 * Post do feed global (Epic 22) — sempre vinculado a um anime, como uma
 * opinião/review curta (não texto solto). Ao contrário de Comment (visível
 * só pra quem também tem esse anilistId na própria lista), Post precisa
 * aparecer no feed global pra qualquer pessoa logada, então o
 * título/capa do anime são congelados (snapshot) aqui na criação a partir
 * da própria linha de Anime do autor — o feed nunca depende do *viewer*
 * também ter esse anime na lista.
 */
model Post {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId         Int?
  animeTitleRomaji  String?
  animeTitleEnglish String?
  animeCoverImage   String?
  body              String
  /// Marca do AUTOR (Figma `13:41840`, P-12): o texto/imagens NÃO saem nas
  /// listas — só pela rota de revelar, por ação explícita. Desmarcado por
  /// padrão e independente de qualquer noção de "assistido".
  isSpoiler         Boolean   @default(false)
  /// URLs coladas pela pessoa (meme/imagem, 0+, exibidas em carrossel) —
  /// sem infraestrutura de upload (nenhum campo de imagem no app tem uma
  /// hoje, nem User.avatarUrl). Renderizado como <img> simples com
  /// onError, não passa pelo next/image (fora do allowlist de
  /// remotePatterns). Sem imagem nenhuma, o corpo do post ocupa esse
  /// mesmo espaço visual (Epic 25).
  imageUrls         String[]  @default([])
  createdAt         DateTime  @default(now())
  /// Soft delete pelo autor ou por admin via fila de denúncia — mesmo
  /// padrão do Comment (Epic 15).
  deletedAt         DateTime?

  /// Citação (Epic 25, estilo Twitter) — post novo com texto/imagem
  /// próprios, embutindo uma pré-visualização só-leitura do citado.
  /// SetNull: apagar o post citado não derruba quem o citou, só perde a
  /// referência.
  quotedPostId String?
  quotedPost   Post?   @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotedBy     Post[]  @relation("PostQuotes")

  /// Repost (Epic 25) — linha própria (userId = quem repostou), sem
  /// corpo/imagem próprios; o feed resolve o conteúdo exibido a partir
  /// do original (repostOf). Curtida/comentário/citação sempre agem
  /// sobre o ORIGINAL, nunca sobre a linha de repost em si — engajamento
  /// não se fragmenta entre um post e cada repost dele (mesmo
  /// comportamento do Twitter de verdade). Repostar um repost/citação
  /// sempre aponta pro original de verdade (nunca uma cadeia).
  repostOfId String?
  repostOf   Post?   @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  repostedBy Post[]  @relation("PostReposts")

  likes    PostLike[]
  hashtags PostHashtag[]
  reports  PostReport[]
  comments PostComment[]

  @@unique([userId, repostOfId])
  @@index([anilistId])
  @@index([userId])
  @@index([deletedAt, createdAt])
}

/// Curtida — par único (postId, userId), mesmo idioma de toggle otimista
/// já usado por FavoriteToggle, estendido de boolean pra {liked, likeCount}.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

/**
 * Comentário por post (Epic 24) — distinto de Comment (Epic 15, por
 * anilistId, só pra quem também tem o anime na própria lista): aqui é por
 * post específico, público, sem exigir o anime na lista de quem comenta.
 * Sem fila de denúncia própria (fora do escopo pedido) — só soft delete
 * pelo autor, mesmo padrão de Comment.
 */
model PostComment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  /// Marca do autor (P-12) — mesmo contrato de Post.isSpoiler.
  isSpoiler Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  reports PostCommentReport[]

  /// Um nível visual de resposta (Figma `13:42257`, decisão provisória do
  /// produto): `parentId` é SEMPRE a resposta de topo; responder a uma
  /// resposta filha mantém o mesmo parentId e registra em `replyToUserId`
  /// a quem se responde ("Em resposta a …"), sem aumentar a indentação.
  parentId      String?
  parent        PostComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PostComment[] @relation("CommentThread")
  replyToUserId String?
  replyToUser   User?         @relation("CommentReplyTo", fields: [replyToUserId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
}

/**
 * Denúncia de post (Epic 22) — fila do administrador, mesmo padrão de
 * CommentReport (Epic 15): upsert idempotente, reabre em resolvedAt/
 * resolvedById quando denunciado de novo depois de resolvido.
 */
model PostReport {
  id           String    @id @default(cuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("PostReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("PostResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  /// SPAM | HARASSMENT | UNMARKED_SPOILER | OTHER (Figma `13:43571`).
  reason       String?

  @@unique([postId, reporterId])
  @@index([postId])
}

/// Denúncia de RESPOSTA (PostComment) — antes não existia (nem o admin
/// conseguia remover uma resposta). Mesmo contrato do PostReport.
model PostCommentReport {
  id           String      @id @default(cuid())
  commentId    String
  comment      PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User        @relation("PostCommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?       @relation("PostCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([commentId, reporterId])
  @@index([commentId])
}

/// Denúncia de PERFIL. Denunciar não bloqueia nem suspende (Figma
/// `13:43571`); a fila só marca como revisada na v1 (suspensão: D-16).
model UserReport {
  id           String    @id @default(cuid())
  targetUserId String
  target       User      @relation("UserReported", fields: [targetUserId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("UserReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("UserReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([targetUserId, reporterId])
  @@index([targetUserId])
}

/// Segue-outra-pessoa (Epic 22) — alimenta a aba "Seguindo" do feed.
/// followerId != followingId é validado na camada de rota (Prisma não
/// tem check constraint declarativa nesta versão do schema), não aqui.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
