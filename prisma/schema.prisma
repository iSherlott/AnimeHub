generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ANIME_HUB_DATABASE_URL")
}

/// Conta opcional — navegar pelo catálogo/calendário/descobrir nunca exige
/// login. Só dados vinculados a uma pessoa (lista pessoal, favoritos,
/// comentários) exigem sessão ativa.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  passwordSalt String
  /// Nome de exibição (não precisa ser único) — mostrado no cabeçalho e em
  /// qualquer conteúdo público que a pessoa publicar (ex.: comentários).
  displayName  String
  avatarUrl    String?
  /// @identificador público e único (minúsculas; ver src/lib/handle.ts).
  /// Opcional até a pessoa escolher o seu.
  handle       String?   @unique
  /// Bio curta e opcional (Epic 28) — texto livre, sem markdown/formatação. No perfil estilo Orkut é o "quem sou eu".
  bio          String?
  /// Perfil estilo Orkut ("quem sou eu"): anime e personagem favoritos (texto livre) e gêneros favoritos (do vocabulário).
  favoriteAnime     String?
  favoriteCharacter String?
  favoriteGenres    String[] @default([])
  /// "ADMIN" | "MEMBER". A primeira conta criada no sistema vira admin
  /// automaticamente (mesmo bootstrap que já herda os dados órfãos).
  role         String    @default("MEMBER")
  /// Preferências da conta (Configurações, Figma `8:3333`/`13:42966`).
  /// titleFormat: "ja" (Japonês) | "romaji" | null (usa o padrão do produto).
  titleFormat  String?
  /// IANA (ex.: "America/Sao_Paulo"), "device" ou null (padrão do produto).
  timeZone     String?
  /// Sinopse quando os títulos estão em japonês: "pt" (padrão) ou "ja".
  synopsisLanguage String?
  /// Banner do perfil (imagem de uma obra que a pessoa acompanha).
  bannerUrl    String?
  /// Título (UserTitle) equipado no perfil — um por vez, ou nenhum.
  equippedTitleId String?
  /// A lista de animes acompanhados aparece no perfil para quem o visita (padrão: sim; dá para ocultar em Configurações).
  animeListPublic Boolean @default(true)
  notifyReleases  Boolean  @default(true)
  notifyReplies   Boolean  @default(true)
  notifyComments  Boolean  @default(true)
  notifyFollowers Boolean  @default(true)
  notifyLikes     Boolean  @default(false)
  /// Avisos das comunidades: respostas nos tópicos em que a pessoa participa e eventos novos nas comunidades dela.
  notifyCommunity Boolean  @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  socialReceived   SocialNotification[] @relation("SocialReceived")
  socialSent       SocialNotification[] @relation("SocialSent")
  pendingEpisodes  PendingEpisode[]
  quizAttempts     QuizAttempt[]
  titles           UserTitle[]
  sessions         Session[]
  animeList        Anime[]
  invitesCreated   Invite[]        @relation("InvitesCreated")
  inviteUsed       Invite?         @relation("InviteUsed")
  airingAlerts     AiringAlert[]
  comments         Comment[]
  commentReports   CommentReport[] @relation("CommentReporter")
  reportsResolved  CommentReport[] @relation("CommentResolver")
  posts               Post[]
  postLikes           PostLike[]
  postComments        PostComment[]
  postReports         PostReport[] @relation("PostReporter")
  postCommentReports        PostCommentReport[] @relation("PostCommentReporter")
  postCommentReportsResolved PostCommentReport[] @relation("PostCommentResolver")
  userReportsMade           UserReport[]        @relation("UserReporter")
  userReportsReceived       UserReport[]        @relation("UserReported")
  userReportsResolved       UserReport[]        @relation("UserReportResolver")
  postReportsResolved PostReport[] @relation("PostResolver")
  following           Follow[]     @relation("Following")
  followers           Follow[]     @relation("Followers")
  postCommentReplyTargets PostComment[] @relation("CommentReplyTo")
  blocksMade          Block[]      @relation("Blocker")
  blocksReceived      Block[]      @relation("Blocked")
  communityMemberships CommunityMember[]
  communityTopics      CommunityTopic[]
  communityReplies     CommunityReply[]
  communityPollVotes   CommunityPollVote[]
  communityEvents      CommunityEvent[]
  communityRsvps       CommunityEventRsvp[]
  communityReports     CommunityReport[] @relation("CommunityReporter")
  communityReportsResolved CommunityReport[] @relation("CommunityReportResolver")
  scrapsReceived       Scrap[]          @relation("ScrapProfile")
  scrapsWritten        Scrap[]          @relation("ScrapAuthor")
  testimonialsReceived Testimonial[]    @relation("TestimonialProfile")
  testimonialsWritten  Testimonial[]    @relation("TestimonialAuthor")
  fansOf               Fan[]            @relation("FanOf")
  fans                 Fan[]            @relation("FanTarget")
  ratingsGiven         ProfileRating[]  @relation("RatingRater")
  ratingsReceived      ProfileRating[]  @relation("RatingTarget")
  friendshipsA         Friendship[]     @relation("FriendshipA")
  friendshipsB         Friendship[]     @relation("FriendshipB")
  friendRequestsSent     FriendRequest[] @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestTo")

  @@index([email])
}

/// Cadastro é só por convite — só um administrador pode gerar um. Cada
/// código vale pra uma única conta.
model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  createdBy String
  creator   User      @relation("InvitesCreated", fields: [createdBy], references: [id], onDelete: Cascade)
  usedById  String?   @unique
  usedBy    User?     @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdBy])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Anime {
  id              String    @id @default(cuid())
  /// Dono da lista — opcional só durante a migração de dados pré-contas;
  /// toda entrada nova é criada já vinculada ao usuário autenticado.
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Não são @unique globalmente — cada usuário tem sua própria lista, então
  /// dois usuários diferentes podem (e vão) acompanhar o mesmo anime, cada
  /// um com sua própria linha. A unicidade é por usuário (@@unique abaixo).
  /// Nulo = obra sem AniList ID (só do AniDB ou da Kitsu): aí a identidade é a obra do catálogo (`catalogEntryId`).
  anilistId       Int?
  /// Obra do catálogo (Fase 2): a identidade interna da obra que a pessoa acompanha.
  catalogEntryId  String?
  catalogEntry    CatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: Restrict)
  kitsuId         Int?
  malId           Int?
  shikimoriId     Int?
  /// ID numérico na AniDB (ex.: 15617). Preenchido manualmente — a busca por
  /// título exigiria baixar o dump anime-titles.xml.gz do domínio principal,
  /// que bloqueia o ambiente onde este projeto roda. Ache o ID na URL da
  /// página do anime em anidb.net.
  anidbId         Int?
  /// Nota média (0-10) vinda da AniDB — comunidade diferente da do MAL.
  anidbRating     Float?
  anidbVotes      Int?
  /// Nota média da comunidade AniList, 0-100 (escala nativa deles). Vem
  /// automaticamente em toda busca/refresh — ao contrário da nota da AniDB,
  /// não depende de vincular manualmente nenhum ID.
  averageScore    Int?
  /// Prêmios recebidos, separados por vírgula (só a AniDB rastreia isso).
  anidbAwards     String?
  /// Links pra outros bancos de dados (MAL, ANN, Wikipedia EN/JP, site
  /// oficial), como JSON {label: url}. Vem do bloco <resources> da AniDB.
  anidbResources  String?
  /// Todos os títulos por idioma que a AniDB conhece (é a fonte mais
  /// completa nisso — às vezes tem até título oficial em português), como
  /// JSON [{language, title, isOfficial}]. Alimenta a lista "Outros títulos".
  anidbTitles     String?
  lastRefreshedAt DateTime?
  titleRomaji     String
  titleEnglish    String?
  titleNative     String?
  /// Título em português — não existe fonte gratuita confiável pra isso,
  /// então é preenchido manualmente pelo usuário (ver TitleEditor).
  titlePortuguese String?
  /// Cache do HTML <ruby>/<rt> gerado a partir de titleNative (kuroshiro +
  /// kuromoji) — evita re-tokenizar toda vez que a página carrega.
  titleFurigana   String?
  coverImage      String?
  bannerImage     String?
  /// Link do site oficial, vindo do externalLinks da AniList (site ===
  /// "Official Site"). Ao contrário dos links de anidbResources, não exige
  /// vincular um anidbId manualmente — vem automático pra qualquer anime.
  officialSite    String?
  /// Trailer do YouTube vindo da AniList (campo `trailer`). Só o id do
  /// vídeo + o site — se não for "youtube" (raro), não tem como embutir e o
  /// campo fica sem uso na UI.
  trailerId       String?
  trailerSite     String?
  /// Elenco de dublagem (Epic 14) — JSON [{role, name, image, voiceActors:
  /// [{name, image, language}]}], todas as línguas de dublagem que a
  /// AniList conhece de uma vez, pra trocar de idioma no cliente sem nova
  /// requisição. Mesmo padrão já usado por anidbTitles/anidbResources —
  /// não precisa de tabela própria.
  castJson        String?
  /// Recomendações da AniList (Epic 14) — JSON [{anilistId, titleRomaji,
  /// titleEnglish, coverImage}]. Resolvidas contra a lista do próprio
  /// usuário na hora de renderizar (não aqui), pra linkar internamente
  /// quando o anime recomendado já estiver na lista.
  recommendationsJson String?
  /// Cor de destaque extraída da capa/banner (ver src/lib/accentColor.ts),
  /// recalculada a cada refresh — usada como tonalidade de fundo na página
  /// de detalhe e no hero da home.
  accentColor     String?
  description     String?
  /// Descrição em português — igual titlePortuguese, sem fonte gratuita
  /// confiável pra tradução automática, então é preenchida manualmente pelo
  /// usuário (ver DescriptionEditor). Exibida no lugar de `description`
  /// quando a preferência de idioma do título estiver em "pt".
  descriptionPortuguese String?
  episodes        Int?
  /// TV / MOVIE / OVA / ONA / SPECIAL / MUSIC — vem da AniList (format) ou
  /// do Type da AniDB.
  format          String?
  status          String?
  season          String?
  seasonYear      Int?
  genres          String?
  seriesKey       String?
  seasonNumber    Int       @default(1)
  /// Curadoria manual do usuário — alimenta o hero rotativo da home
  /// (ver HeroBannerRotator). Não tem relação com WatchStatus.
  isFavorite      Boolean   @default(false)
  /// Marcado quando isFavorite vira true, limpo quando vira false — define
  /// a ordem do hero rotativo sem ser afetado por outros updatedAt (título,
  /// refresh, etc.) que não têm nada a ver com favoritar.
  favoritedAt     DateTime?
  /// "Espera": a obra segue na lista (e no perfil), mas a pessoa não vai acompanhá-la no lançamento — fica fora do
  /// calendário "Minha Lista", dos alertas e de "Para assistir".
  waiting         Boolean   @default(false)
  waitingSince    DateTime?
  /// Marcação manual do andamento (WATCHING | UNFINISHED | FINISHED). Nula = a plataforma deduz (src/lib/watchCategory.ts).
  watchState      String?
  /// Nota (0-10) que a pessoa deu ao terminar a obra: alimenta a nota do site (`CatalogEntry.siteScore`).
  userScore       Int?
  scoredAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  platformLinks PlatformLink[]

  @@unique([userId, anilistId])
  @@unique([userId, kitsuId])
  /// Uma vez por pessoa cada obra do catálogo — vale também para as obras sem AniList ID.
  @@unique([userId, catalogEntryId])
  @@index([seriesKey])
  @@index([userId])
  @@index([catalogEntryId])
  @@index([userId, isFavorite])
  @@index([userId, waiting])
}

/**
 * Franquia canônica (D-18, aprovada) — agrupa as produções (temporadas,
 * filmes, OVAs) de uma mesma obra, derivada das `relations` da AniList
 * (src/lib/franchise.ts), NÃO do título. Compartilhada por todos os usuários.
 */
model Franchise {
  id            String       @id @default(cuid())
  /// anilistId da produção mais antiga da cadeia PREQUEL/PARENT.
  rootAnilistId Int          @unique
  name          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  productions   Production[]
}

/**
 * Produção canônica (D-18/D-03) — uma entrada de catálogo (temporada,
 * filme, OVA…) compartilhada por todos: base do detalhe público de obra.
 * Metadados vivem aqui UMA vez; o estado pessoal (acompanhar, favorito,
 * overrides) continua em `Anime` por usuário até a fatia F4.
 */
model Production {
  id           String    @id @default(cuid())
  anilistId    Int       @unique
  /// Obra do catálogo (Fase 2): a identidade interna; preenchida pelo anilistId e mantida por quem cria a produção.
  catalogEntryId String?  @unique
  catalogEntry   CatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: Restrict)
  franchiseId  String
  franchise    Franchise @relation(fields: [franchiseId], references: [id], onDelete: Restrict)
  /// 1 + temporadas (TV/TV_SHORT) anteriores na cadeia da franquia.
  seasonNumber Int       @default(1)
  /// TV / TV_SHORT / MOVIE / OVA / ONA / SPECIAL / MUSIC (formato AniList).
  format       String?
  titleRomaji  String
  titleEnglish String?
  titleNative  String?
  coverImage   String?
  bannerImage  String?
  description  String?
  episodes     Int?
  status       String?
  season       String?
  seasonYear   Int?
  genres       String?
  officialSite String?
  /// JSON [{site, url}] — sites onde assistir (links STREAMING da AniList). `null` = ainda não consultado; "[]" = consultado, sem links.
  streamingLinksJson String?
  /// O título (`titleRomaji`) foi fixado (o do AniDB) e a atualização pela AniList não o sobrescreve.
  titleLocked  Boolean   @default(false)
  /// ID da produção na AniDB, vinculado pela importação revisada (Admin → Matching).
  anidbId      Int?      @unique
  /// JSON [{id, titleRomaji, format, relationType}] — relações da AniList (sequências, spin-offs…).
  relationsJson String?
  createdAt    DateTime  @default(now())
  fetchedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([franchiseId])
}

/**
 * Registro de execuções dos serviços de dados (calendar-loader, notifier…):
 * base do painel Admin → Execuções (ADMIN-003/004). Retenção curta.
 */
model IngestionRun {
  id             String   @id @default(cuid())
  /// "calendar-loader" | "notifier" | ...
  source         String
  startedAt      DateTime
  finishedAt     DateTime
  /// "OK" | "PARTIAL" | "ERROR"
  status         String
  itemsProcessed Int      @default(0)
  itemsFailed    Int      @default(0)
  message        String?

  @@index([source, startedAt])
}

/**
 * Bloqueio de perfil (D-10): bidirecional para visibilidade e interação
 * (ver src/lib/blocks.ts). Bloquear também desfaz o seguir nos dois sentidos.
 */
/**
 * Hashtag canônica (D-13; Figma `13:42068`): `key` é o ID canônico
 * (NFKC + minúsculas), `display` o nome da 1ª ocorrência. Não associa o post
 * a nenhum anime.
 */
model Hashtag {
  id        String        @id @default(cuid())
  key       String        @unique
  display   String
  /// WORK | SEASON | GENRE | TOPIC (ver src/lib/hashtags.ts#classifyHashtag).
  kind      String        @default("TOPIC")
  /// Obra à qual a # está vinculada (as # das notícias do NewsHub sempre têm uma).
  anilistId Int?
  createdAt DateTime      @default(now())
  posts     PostHashtag[]

  @@index([anilistId])
}

model PostHashtag {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, hashtagId])
  @@index([hashtagId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model PlatformLink {
  id        String   @id @default(cuid())
  animeId   String
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  createdAt DateTime @default(now())

  @@unique([animeId, platform])
}

/**
 * Comentário por anime (Epic 15) — chave por anilistId, não por Anime.id:
 * cada usuário tem sua própria linha de Anime por anilistId (isolamento do
 * Epic 11), então o comentário precisa aparecer pra qualquer um que tenha
 * esse mesmo anime na lista, não só pra quem comentou.
 */
model Comment {
  id        String    @id @default(cuid())
  /// Nulo = comentário de obra sem AniList ID (só do AniDB/Kitsu): a obra é `catalogEntryId`.
  anilistId Int?
  catalogEntryId String?
  catalogEntry   CatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  /// Soft delete (pelo autor ou por um admin via fila de denúncia) — mantém
  /// o histórico de CommentReport íntegro em vez de um hard-delete que
  /// quebraria a referência.
  deletedAt DateTime?

  reports CommentReport[]

  @@index([anilistId])
  @@index([catalogEntryId])
  @@index([userId])
}

/**
 * Denúncia de comentário (Epic 15) — fila que o administrador revisa;
 * denunciar não remove o comentário automaticamente.
 */
model CommentReport {
  id           String    @id @default(cuid())
  commentId    String
  comment      Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("CommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([commentId, reporterId])
  @@index([commentId])
}

/**
 * Cache do catálogo "Descobrir" — animes que ainda podem não estar na sua
 * lista. Guardamos o que a AniList/Kitsu já nos deram (imagens, datas de
 * início/fim, nº de episódios, previsão do próximo episódio) para a tela de
 * Descobrir continuar funcionando mesmo se essas APIs ficarem fora do ar.
 */
model CatalogEntry {
  id                String    @id @default(cuid())
  anilistId         Int?      @unique
  kitsuId           Int?      @unique
  /// Entradas criadas pela importação revisada (Admin → Importações) não têm AniList.
  anidbId           Int?      @unique
  /// ID na MyAnimeList (idMal da AniList) — chave das notícias (Jikan).
  malId             Int?
  /// Tipo da obra (formato AniList): TV, TV_SHORT, MOVIE, OVA, ONA, SPECIAL, MUSIC. Nulo = ainda não conhecido.
  format            String?
  titleRomaji       String
  titleEnglish      String?
  titleNative       String?
  coverImage        String?
  bannerImage       String?
  description       String?
  episodes          Int?
  status            String?
  season            String?
  seasonYear        Int?
  genres            String?
  /// Nota média da comunidade AniList, 0-100 (escala nativa deles) — só
  /// disponível pra entradas vindas dessa fonte (source: "anilist").
  averageScore      Int?
  startDate         DateTime?
  endDate           DateTime?
  nextEpisodeNumber Int?
  nextEpisodeAt     DateTime?
  /// Posição no ranking de popularidade de quando foi buscado (1 = mais
  /// popular). Vem do sort by popularity da AniList ou do /trending da
  /// Kitsu — alimenta a fileira "Em alta" do Descobrir.
  popularityRank    Int?
  source            String
  /// Faz parte da plataforma (visível no Descobrir, na busca, no calendário e nas recomendações). Obras que a AniList
  /// devolve só para cache entram com `false` e só viram `true` quando o admin as traz (upload do HTML do AniDB ou
  /// painel de importação da AniList). Padrão `true` para as demais origens (importação revisada).
  onPlatform        Boolean   @default(true)
  /// O título (`titleRomaji`) foi fixado (hoje: o do AniDB, ao religar a obra à AniList) e a AniList não o sobrescreve.
  titleLocked       Boolean   @default(false)
  /// Última vez que o painel Admin → AniList conferiu esta obra na AniList ("Complementar"). O que continuou vazio depois
  /// disso é porque a AniList não tem — deixa de contar como pendência.
  complementedAt    DateTime?
  /// Tipo na linha da história (Epic 42): EPISODE (série), OVA, ODA (DVD), MOVIE ou OTHER (música…). Derivado de `format`.
  kind              String?
  /// Site oficial da obra (link "Official Site" da AniList).
  officialSite      String?
  /// Sinopse em português e em japonês (a original em inglês é `description`); preenchidas pela tradução guardada.
  descriptionPt     String?
  descriptionJa     String?
  /// Estado da sinopse em português (Fase 7): AUTO (tradução automática) | REVIEWED (automática aprovada) | MANUAL
  /// (escrita pelo admin). Nulo com `descriptionPt` vazio = pendente (há original) ou ausente (não há).
  descriptionPtStatus String?
  /// De onde veio a tradução (motor, ex.: "libretranslate", "mymemory", ou "admin").
  descriptionPtSource String?
  descriptionPtReviewedBy String?
  descriptionPtReviewedAt DateTime?
  /// JSON [{id, titleRomaji, format, relationType}] — relações da AniList (sequência, OVA, filme…): base da linha do tempo.
  relationsJson     String?
  /// Nota do site (0-10): começa em 5 e é regulada pelas notas de quem terminou a obra (src/lib/siteScore.ts).
  siteScore         Float     @default(5)
  siteScoreVotes    Int       @default(0)
  /// Quando a curadoria passou por esta obra e com qual versão das regras (reprocessa quando a versão sobe).
  curatedAt         DateTime?
  curationVersion   Int       @default(0)
  /// Franquia (Epic 45): menor anilistId do grupo de obras ligadas por sequência, spin-off, OVA, filme… Nulo = fora da AniList.
  franchiseKey      Int?
  /// Posição da obra na linha do tempo cronológica da franquia (1 = a mais antiga), com séries, OVA, ODA e filmes juntos.
  timelineOrder     Int?
  /// MAIN (série da linha principal), RELATED (outra série ligada) ou SPECIAL (OVA, ODA, filme, outros).
  timelineRole      String?
  /// Número da temporada na linha principal (1, 2, 3…); só nas obras MAIN.
  timelineSeason    Int?
  timelineAt        DateTime?
  /// Atraso do streaming (Epic 50): quantos minutos depois da TV japonesa (o horário da fonte) o episódio sai na
  /// plataforma de streaming (`streamingSite`, ex.: Crunchyroll). A agenda (AiringScheduleEntry) e o próximo episódio já
  /// são gravados com esse atraso somado; nulo = horário da TV japonesa.
  streamingDelayMinutes Int?
  streamingSite     String?
  fetchedAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([season, seasonYear])
  @@index([onPlatform])
  @@index([format])
  @@index([kind])
  @@index([franchiseKey, timelineOrder])

  /// Campos corrigidos à mão (Fase 3): a importação e a curadoria não os sobrescrevem. Ex.: ["titleRomaji", "description"].
  manualFields      String[]  @default([])

  // Identidade interna (Fase 2, ADR 0008): as cópias e a agenda apontam para a obra pelo id do catálogo; o anilistId é só
  // um identificador externo (obras só do AniDB não têm).
  productions       Production[]
  listEntries       Anime[]
  schedule          AiringScheduleEntry[]
  /// Índice dos gêneros (Fase 7, ADR 0010): mantido pelo banco a partir de `genres`.
  genreLinks        CatalogGenre[]
  /// Extras do AniDB (especiais, aberturas/encerramentos, trailers…), fora da sequência regular.
  extras            EpisodeExtra[]
  /// Comunidade das obras sem AniList ID (publicações, comentários e quiz vão pela obra do catálogo).
  posts             Post[]
  comments          Comment[]
  quiz              Quiz?
  /// Comunidade da obra sem franquia (só do AniDB/Kitsu); as demais ficam na comunidade da franquia (`franchiseKey`).
  community         Community?
  /// Tópicos da comunidade que dizem de qual obra (temporada, filme…) falam.
  communityTopics   CommunityTopic[]
}

/**
 * Extras de uma obra vindos do AniDB: especiais (S1), aberturas e encerramentos (C1), trailers (T1), paródias (P1) e
 * outros (O1). Ficam fora da sequência 1, 2, 3 — não contam como episódio lançado, não entram no calendário nem no sino.
 * Identidade: (obra do catálogo, código do AniDB). Apagados junto com a obra (são só dados da fonte).
 */
model EpisodeExtra {
  id             String       @id @default(cuid())
  catalogEntryId String
  catalogEntry   CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  /// Código do AniDB: S1, C2, T1, P1, O1.
  code           String
  /// SPECIAL | CREDIT | TRAILER | PARODY | OTHER
  kind           String
  /// Número dentro do tipo (o 2 de "S2").
  number         Int
  title          String?
  titleEn        String?
  titleJa        String?
  synopsis       String?
  /// Só o dia (o AniDB não informa horário).
  airDate        DateTime?    @db.Date
  source         String       @default("anidb")
  /// Campos corrigidos à mão: a fonte não sobrescreve.
  manualFields   String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([catalogEntryId, code])
  @@index([catalogEntryId, kind])
}

/**
 * Vocabulário de gêneros (Fase 7, ADR 0010). `key` é o nome gravado nas obras (`CatalogEntry.genres`). O banco aplica o
 * vocabulário em toda gravação: variações (`aliases`) e gêneros mesclados (`mergedInto`) viram o destino; gênero
 * excluído some. Gênero que aparece numa obra sem estar aqui entra como não registrado, para o admin revisar.
 */
model Genre {
  key         String         @id
  /// Como aparece no produto (os nomes ficam em inglês/japonês romanizado; ver genreTaxonomy).
  label       String
  description String?
  /// Variações de escrita que viram este gênero (comparação sem maiúsculas).
  aliases     String[]       @default([])
  /// Gênero mesclado: o destino. Toda gravação com esta chave passa a gravar o destino.
  mergedInto  String?
  /// Marcador de conteúdo adulto (ver contentPolicy).
  adult       Boolean        @default(false)
  /// false = excluído (as obras foram transferidas ou desligadas antes).
  active      Boolean        @default(true)
  /// false = apareceu numa obra sem estar no vocabulário: revisar (registrar, mesclar ou excluir).
  registered  Boolean        @default(true)
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  works       CatalogGenre[]
}

/** Obra ↔ gênero (Fase 7): índice relacional mantido por gatilho a partir de `CatalogEntry.genres`. */
model CatalogGenre {
  catalogEntryId String
  catalogEntry   CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  genreKey       String
  genre          Genre        @relation(fields: [genreKey], references: [key], onUpdate: Cascade, onDelete: Restrict)

  @@id([catalogEntryId, genreKey])
  @@index([genreKey])
}

/**
 * Pendência da curadoria do catálogo (Epic 42): algo que a curadoria não conseguiu resolver sozinha (título sem inglês,
 * obra fora da AniList, tipo desconhecido…). É a lista que vira o ADR de pendências (docs/adr). Uma por obra e motivo.
 */
model CurationIssue {
  id        String   @id @default(cuid())
  entryId   String
  anilistId Int?
  anidbId   Int?
  title     String
  /// Motivo (ver src/lib/curation/issues.ts).
  code      String
  detail    String?
  /// OPEN | RESOLVED | DISMISSED (ignorada com justificativa)
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Fase 7: quando foi resolvida (para o tempo médio de resolução), quantas vezes reabriu, e a justificativa de ignorar.
  resolvedAt      DateTime?
  reopenCount     Int       @default(0)
  dismissedReason String?
  dismissedBy     String?

  @@unique([entryId, code])
  @@index([code, status])
}

/**
 * Cache do calendário de lançamentos — episódios com data/hora de exibição
 * confirmada pela AniList (AiringSchedule). É o equivalente legítimo (via
 * API pública) ao "simulcast calendar" da Crunchyroll: não fazemos scraping
 * do site deles nem do AniDB (ambos proíbem isso nos termos de uso e têm
 * proteção antibot) — a AniList expõe exatamente esse dado por API aberta.
 */
model AiringScheduleEntry {
  id           String   @id @default(cuid())
  /// AniList da obra. Nulo nas obras só do AniDB (episódios vindos do AniDB, sem horário): aí a identidade é
  /// (catalogEntryId, episode).
  anilistId    Int?
  /// Obra do catálogo (Fase 2).
  catalogEntryId String?
  catalogEntry   CatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: Restrict)
  episode      Int
  /// Instante real (UTC) do lançamento no streaming. Nulo quando a fonte só tem a data (`airDate`) ou nada (Fase 4):
  /// nunca se inventa horário.
  airingAt     DateTime?
  /// Os títulos abaixo são cópias do título da OBRA (para o calendário); os do EPISÓDIO ficam em `episodeTitle*`.
  titleRomaji  String
  titleEnglish String?
  titleNative  String?
  coverImage   String?
  bannerImage  String?
  genres       String?
  /// Sinopse (Epic 29) — pedida na mesma busca AniList que popula o
  /// resto da linha (services/calendar-loader), pra dar pro preview do
  /// calendário mostrar sinopse mesmo de anime fora da lista do viewer.
  description  String?
  fetchedAt    DateTime @default(now())
  /// Episódio global (Fase 4, ADR 0009): título, sinopse e imagem do episódio, iguais para todo mundo.
  episodeTitle   String?
  episodeTitleEn String?
  episodeTitleJa String?
  synopsis       String?
  thumbnail      String?
  /// Só a data, quando a fonte não informa o horário.
  airDate        DateTime? @db.Date
  /// Grau de certeza da data: EXACT (data e hora) | DATE_ONLY (só o dia) | UNKNOWN (sem data).
  dateCertainty  String    @default("EXACT")
  /// Situação informada pela fonte ou pelo admin: ACTIVE | POSTPONED | CANCELLED. "Exibido" não é guardado: vem da data.
  status         String    @default("ACTIVE")
  /// De onde veio o registro: anilist | kitsu | anidb | manual.
  source         String    @default("anilist")
  /// Campos corrigidos à mão: a fonte não sobrescreve.
  manualFields   String[]  @default([])
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([anilistId, episode])
  @@unique([catalogEntryId, episode])
  @@index([airingAt])
  @@index([catalogEntryId])
}

/**
 * Última consulta de episódios de uma obra no AniDB (obras sem AniList ID): o AniDB limita as consultas, então cada obra
 * é consultada no máximo uma vez por período e o lote retoma de onde parou.
 */
model AnidbEpisodeCheck {
  catalogEntryId String   @id
  anidbId        Int
  found          Int      @default(0)
  /// Erro da última consulta (nulo = deu certo).
  error          String?
  checkedAt      DateTime @default(now())
}

/** Última consulta de episódios de uma obra a uma fonte (Fase 4): evita perguntar de novo a cada visita. */
model EpisodeSourceCheck {
  anilistId Int      @id
  kitsuId   Int?
  found     Int      @default(0)
  checkedAt DateTime @default(now())
}

/**
 * Alerta de "favorito no ar agora" (Epic 10) — escrito só pelo serviço
 * `services/notifier` (a cada ~2min, junção de Anime x AiringScheduleEntry
 * por anilistId dentro de uma janela de exibição). O BFF só lê esta tabela
 * (GET /api/notifications) e marca `seenAt` quando a pessoa vê o alerta.
 */
model AiringAlert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId Int
  episode   Int
  airingAt  DateTime
  seenAt    DateTime?
  /// Horário anterior quando a data do episódio MUDOU depois do alerta
  /// ("Data alterada", Figma 13:43025); null = alerta de lançamento normal.
  previousAiringAt DateTime?
  /// "EPISODE" (lançamento / data alterada) | "RETURN" (a obra, ou uma continuação dela, voltou a sair episódios; `episode` = 0).
  kind      String    @default("EPISODE")
  createdAt DateTime  @default(now())

  @@unique([userId, anilistId, episode])
  @@index([userId, seenAt])
}

/**
 * Notificação SOCIAL (canal separado de "Lançamentos"): resposta à
 * publicação, resposta ao comentário, novo seguidor, curtida (OFF por
 * padrão). Guarda só QUEM e ONDE — nunca texto do conteúdo (spoiler-safe).
 */
model SocialNotification {
  id        String    @id @default(cuid())
  /// Quem recebe.
  userId    String
  user      User      @relation("SocialReceived", fields: [userId], references: [id], onDelete: Cascade)
  /// Quem fez a ação.
  actorId   String
  actor     User      @relation("SocialSent", fields: [actorId], references: [id], onDelete: Cascade)
  /// "POST_REPLY" | "COMMENT_REPLY" | "NEW_FOLLOWER" | "POST_LIKE" | "PROFILE_SCRAP" | "PROFILE_TESTIMONIAL" | "PROFILE_FAN"
  /// | "COMMUNITY_REPLY" | "COMMUNITY_EVENT" | "FRIEND_REQUEST" | "FRIEND_ACCEPTED"
  type      String
  postId    String?
  commentId String?
  /// Comunidades: o tópico (e a resposta mais recente) ou o evento do aviso.
  topicId   String?
  replyId   String?
  eventId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/**
 * Post do feed global (Epic 22) — sempre vinculado a um anime, como uma
 * opinião/review curta (não texto solto). Ao contrário de Comment (visível
 * só pra quem também tem esse anilistId na própria lista), Post precisa
 * aparecer no feed global pra qualquer pessoa logada, então o
 * título/capa do anime são congelados (snapshot) aqui na criação a partir
 * da própria linha de Anime do autor — o feed nunca depende do *viewer*
 * também ter esse anime na lista.
 */
model Post {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId         Int?
  /// Obra sem AniList ID (só do AniDB/Kitsu) escolhida como contexto da publicação.
  catalogEntryId    String?
  catalogEntry      CatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  animeTitleRomaji  String?
  animeTitleEnglish String?
  animeCoverImage   String?
  body              String
  /// Marca do AUTOR (Figma `13:41840`, P-12): o texto/imagens NÃO saem nas
  /// listas — só pela rota de revelar, por ação explícita. Desmarcado por
  /// padrão e independente de qualquer noção de "assistido".
  isSpoiler         Boolean   @default(false)
  /// URLs coladas pela pessoa (meme/imagem, 0+, exibidas em carrossel) —
  /// sem infraestrutura de upload (nenhum campo de imagem no app tem uma
  /// hoje, nem User.avatarUrl). Renderizado como <img> simples com
  /// onError, não passa pelo next/image (fora do allowlist de
  /// remotePatterns). Sem imagem nenhuma, o corpo do post ocupa esse
  /// mesmo espaço visual (Epic 25).
  imageUrls         String[]  @default([])
  createdAt         DateTime  @default(now())
  /// Soft delete pelo autor ou por admin via fila de denúncia — mesmo
  /// padrão do Comment (Epic 15).
  deletedAt         DateTime?

  /// Citação (Epic 25, estilo Twitter) — post novo com texto/imagem
  /// próprios, embutindo uma pré-visualização só-leitura do citado.
  /// SetNull: apagar o post citado não derruba quem o citou, só perde a
  /// referência.
  quotedPostId String?
  quotedPost   Post?   @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotedBy     Post[]  @relation("PostQuotes")

  /// Repost (Epic 25) — linha própria (userId = quem repostou), sem
  /// corpo/imagem próprios; o feed resolve o conteúdo exibido a partir
  /// do original (repostOf). Curtida/comentário/citação sempre agem
  /// sobre o ORIGINAL, nunca sobre a linha de repost em si — engajamento
  /// não se fragmenta entre um post e cada repost dele (mesmo
  /// comportamento do Twitter de verdade). Repostar um repost/citação
  /// sempre aponta pro original de verdade (nunca uma cadeia).
  repostOfId String?
  repostOf   Post?   @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  repostedBy Post[]  @relation("PostReposts")

  likes    PostLike[]
  hashtags PostHashtag[]
  reports  PostReport[]
  comments PostComment[]

  @@unique([userId, repostOfId])
  @@index([anilistId])
  @@index([catalogEntryId])
  @@index([userId])
  @@index([deletedAt, createdAt])
}

/// Curtida — par único (postId, userId), mesmo idioma de toggle otimista
/// já usado por FavoriteToggle, estendido de boolean pra {liked, likeCount}.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

/**
 * Comentário por post (Epic 24) — distinto de Comment (Epic 15, por
 * anilistId, só pra quem também tem o anime na própria lista): aqui é por
 * post específico, público, sem exigir o anime na lista de quem comenta.
 * Sem fila de denúncia própria (fora do escopo pedido) — só soft delete
 * pelo autor, mesmo padrão de Comment.
 */
model PostComment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  /// Marca do autor (P-12) — mesmo contrato de Post.isSpoiler.
  isSpoiler Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  reports PostCommentReport[]

  /// Um nível visual de resposta (Figma `13:42257`, decisão provisória do
  /// produto): `parentId` é SEMPRE a resposta de topo; responder a uma
  /// resposta filha mantém o mesmo parentId e registra em `replyToUserId`
  /// a quem se responde ("Em resposta a …"), sem aumentar a indentação.
  parentId      String?
  parent        PostComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PostComment[] @relation("CommentThread")
  replyToUserId String?
  replyToUser   User?         @relation("CommentReplyTo", fields: [replyToUserId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
}

/**
 * Denúncia de post (Epic 22) — fila do administrador, mesmo padrão de
 * CommentReport (Epic 15): upsert idempotente, reabre em resolvedAt/
 * resolvedById quando denunciado de novo depois de resolvido.
 */
model PostReport {
  id           String    @id @default(cuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("PostReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("PostResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  /// SPAM | HARASSMENT | UNMARKED_SPOILER | OTHER (Figma `13:43571`).
  reason       String?

  @@unique([postId, reporterId])
  @@index([postId])
}

/// Denúncia de RESPOSTA (PostComment) — antes não existia (nem o admin
/// conseguia remover uma resposta). Mesmo contrato do PostReport.
model PostCommentReport {
  id           String      @id @default(cuid())
  commentId    String
  comment      PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User        @relation("PostCommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?       @relation("PostCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([commentId, reporterId])
  @@index([commentId])
}

/// Denúncia de PERFIL. Denunciar não bloqueia nem suspende (Figma
/// `13:43571`); a fila só marca como revisada na v1 (suspensão: D-16).
model UserReport {
  id           String    @id @default(cuid())
  targetUserId String
  target       User      @relation("UserReported", fields: [targetUserId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("UserReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("UserReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([targetUserId, reporterId])
  @@index([targetUserId])
}

/// Segue-outra-pessoa (Epic 22) — alimenta a aba "Seguindo" do feed.
/// followerId != followingId é validado na camada de rota (Prisma não
/// tem check constraint declarativa nesta versão do schema), não aqui.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}


/**
 * Job operacional da área Admin (Figma "Jobs", `8:4740`; Job Detail `8:4919`).
 * Hoje só existe o job de importação revisada (HTML colado → parse → normalize
 * → matching → prévia → confirmação → commit). `seq` é o "#185" mostrado na UI.
 * Nenhum job mede consumo (D-02).
 */
model AdminJob {
  seq           Int               @id @default(autoincrement())
  /// "IMPORT"
  kind          String
  /// "AniDB"
  source        String
  /// "Autumn2026"
  season        String?
  /// PENDING | RUNNING | SUCCESS | FAILED | CANCELLED
  state         String
  /// Etapa atual: PARSE | NORMALIZE | MATCHING | COMMIT | BROADCAST | NOTIFICATION
  stage         String
  parserVersion String?
  total         Int               @default(0)
  processed     Int               @default(0)
  error         String?
  htmlBytes     Int?
  /// HTML original, preservado para revisão ou nova tentativa (tratado sempre como texto).
  html          String?
  /// Resultado do commit (JSON): vínculos, novas, episódios no calendário, pendências de produção. Mostrado no resultado do lote.
  resultJson    String?
  /// Passo em andamento, em palavras ("Comparando 40 de 117…"), para a tela mostrar o progresso. Nulo quando nada está rodando.
  progressNote  String?
  adminId       String?
  adminName     String?
  createdAt     DateTime          @default(now())
  finishedAt    DateTime?
  /// Sinal de vida (Fase 8): o job grava a cada passo; sem sinal por muito tempo, é dado como interrompido.
  heartbeatAt   DateTime?
  /// Pedido de cancelamento (Fase 8): o job para no próximo passo, sem desfazer o que já gravou.
  cancelRequestedAt DateTime?
  records       ImportRecord[]
  conflicts     CatalogConflict[]
  logs          AdminLog[]
  fieldUpdates  FieldUpdateItem[]

  @@index([createdAt])
}

/** Registro extraído do HTML e o resultado do matching contra o catálogo (Figma `8:4020`, `8:4179`). */
/**
 * Atualização seletiva de campos (Fase 6, Cenário F): o que a fonte devolveu para cada obra, campo a campo, ANTES de
 * tocar no catálogo. Uma linha por (lote, obra). O admin escolhe os campos; a execução confere se o valor atual ainda é
 * o da coleta e registra cada mudança no ChangeLog com o lote.
 */
model FieldUpdateItem {
  id             String    @id @default(cuid())
  jobSeq         Int
  job            AdminJob  @relation(fields: [jobSeq], references: [seq], onDelete: Cascade)
  catalogEntryId String
  anilistId      Int?
  /// Identificador da obra na fonte do lote (AniList, Kitsu ou AniDB — ver AdminJob.source). Nulo nos lotes antigos.
  sourceId       Int?
  title          String
  /// JSON [{ field, group, current, incoming, changed, protected, missing }]
  diffJson       String?
  /// JSON string[]: campos escolhidos para aplicar
  selectedJson   String?
  /// PENDING | COLLECTED | NOT_FOUND | FAILED | APPLIED | UNCHANGED | SKIPPED | CONFLICT
  state          String    @default("PENDING")
  message        String?
  collectedAt    DateTime?
  appliedAt      DateTime?

  @@index([jobSeq, state])
}

model ImportRecord {
  id                  String   @id @default(cuid())
  jobSeq              Int
  job                 AdminJob @relation(fields: [jobSeq], references: [seq], onDelete: Cascade)
  /// Identificador na fonte (AniDB).
  sourceKey           String
  titleRomaji         String
  titleNative         String?
  titleEnglish        String?
  seasonLabel         String?
  year                Int?
  format              String?
  /// Horário de exibição informado pela fonte (ISO) — nunca inventado.
  airsAt              DateTime?
  airsAtHasTime       Boolean  @default(false)
  capturedAt          DateTime @default(now())
  matchedProductionId String?
  matchedAnilistId    Int?
  score               Float?
  /// JSON {title, season, year, image} (0..1; ausente = sem dado).
  scoreDetail         String?
  /// AUTO | NEW | PENDING | CONFIRMED | IGNORED
  state               String
  note                String?
  /// Sinopse e sites de streaming que vieram no HTML (JSON [{site,url}]).
  description         String?
  linksJson           String?
  episodes            Int?
  imageUrl            String?
  /// Gêneros (taxonomia fechada) lidos das tags do AniDB, separados por vírgula.
  genres              String?
  decidedByName       String?
  decidedAt           DateTime?

  @@index([jobSeq, state])
}

/** Divergência entre duas fontes para um mesmo campo (Figma "Conflitos", `8:4327`). */
model CatalogConflict {
  id            String    @id @default(cuid())
  jobSeq        Int?
  job           AdminJob? @relation(fields: [jobSeq], references: [seq], onDelete: SetNull)
  anilistId     Int
  episode       Int
  /// "airingAt"
  field         String
  titleSnapshot String
  aValue        DateTime
  aSource       String
  bValue        DateTime
  bSource       String
  bMeta         String?
  /// PENDING | RESOLVED
  status        String    @default("PENDING")
  /// "A" | "B" | "MANUAL"
  resolution    String?
  resolvedValue DateTime?
  reason        String?
  decidedByName String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
  @@index([anilistId, episode])
}

/**
 * Decisão do admin (Admin → Match name) sobre duas obras cujo nome sugere continuação ("Naruto" → "Naruto Shippuden",
 * "Naruto" → "Boruto"). `CONFIRMED` junta as duas na mesma franquia (a mais nova vira a temporada seguinte);
 * `REJECTED` impede que a mesma sugestão volte.
 */
model WorkLink {
  id               String   @id @default(cuid())
  /// A obra que veio antes.
  earlierAnilistId Int
  /// A continuação.
  laterAnilistId   Int
  /// CONFIRMED | REJECTED
  status           String
  /// SUGGESTED (veio da lista de sugestões) | MANUAL (o admin escolheu as duas obras)
  origin           String   @default("SUGGESTED")
  /// JSON com a franquia e os números de temporada de antes da junção — é o que "Desfazer" restaura.
  undoJson         String?
  decidedByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([earlierAnilistId, laterAnilistId])
  @@index([status])
  @@index([laterAnilistId])
}

/**
 * Candidata da AniList para uma obra que só existe pelo AniDB (sem página): guardada pelo religamento quando o casamento
 * não é seguro, para o admin decidir em Admin → Match name. `REJECTED` impede que a mesma sugestão volte.
 */
model AnidbCandidate {
  id             String   @id @default(cuid())
  anidbId        Int      @unique
  anilistId      Int
  candidateTitle String
  score          Float
  /// Por que não foi ligada sozinha.
  reason         String
  /// PENDING | REJECTED
  status         String   @default("PENDING")
  decidedByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}
/** Valor manual com prioridade; origem preservada e trilha de auditoria (Figma "Overrides", `8:4471`). */
model CatalogOverride {
  id             String    @id @default(cuid())
  anilistId      Int
  episode        Int
  /// "airingAt"
  field          String
  titleSnapshot  String
  originalValue  DateTime
  originalSource String
  value          DateTime
  reason         String
  adminName      String
  createdAt      DateTime  @default(now())
  removedAt      DateTime?
  removedByName  String?

  @@index([anilistId, episode, removedAt])
}

/** Eventos de domínio legíveis (Figma "Logs", `8:5077`): timestamp, fonte, job, evento e contexto. */
model AdminLog {
  id        String    @id @default(cuid())
  at        DateTime  @default(now())
  jobSeq    Int?
  job       AdminJob? @relation(fields: [jobSeq], references: [seq], onDelete: SetNull)
  source    String?
  /// INFO | WARN | ERROR
  level     String    @default("INFO")
  event     String
  message   String
  context   String?
  adminName String?

  @@index([at])
  @@index([jobSeq, at])
}


/**
 * Miniatura de um episódio específico (Kitsu), por AniList id + número — o
 * calendário mostra essa imagem (ou a capa do anime, se não houver). Preenchida
 * pelo job diário das 00:00 (America/Sao_Paulo) ou pelo botão do Admin.
 */
model EpisodeImage {
  anilistId Int
  episode   Int
  thumbnail String
  source    String   @default("kitsu")
  fetchedAt DateTime @default(now())

  @@id([anilistId, episode])
}

/** Cache do vínculo AniList → Kitsu (evita consultar o mesmo mapeamento a cada execução). */
model EpisodeImageSource {
  anilistId Int      @id
  kitsuId   Int?
  checkedAt DateTime @default(now())
}

/** Histórico/lock das execuções do job de imagens de episódios (Admin → Scrapers). */
model EpisodeImageRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | OK | PARTIAL | ERROR
  status     String
  /// "schedule" | "manual"
  trigger    String
  animes     Int       @default(0)
  found      Int       @default(0)
  failed     Int       @default(0)
  message    String?
  adminName  String?

  @@index([startedAt])
}


/** Leitura em kana e furigana (<ruby>) de um título japonês, gerada uma vez e reaproveitada. */
model TitleReading {
  text         String   @id
  kana         String
  furiganaHtml String
  createdAt    DateTime @default(now())
}

/** Sinopse traduzida (pt/ja) de uma obra da AniList — traduzida uma vez, na primeira vez que é pedida. */
model SynopsisTranslation {
  anilistId Int
  lang      String
  text      String
  source    String
  updatedAt DateTime @updatedAt

  @@id([anilistId, lang])
}

/** Notícia sobre uma obra da temporada (Jikan/MyAnimeList), guardada pelo serviço news-fetcher. */
model AnimeNews {
  id          String   @id @default(cuid())
  anilistId   Int
  url         String
  title       String
  excerpt     String?
  imageUrl    String?
  author      String?
  publishedAt DateTime
  source      String   @default("MyAnimeList")
  fetchedAt   DateTime @default(now())
  /// Publicação do NewsHub que já mostra esta notícia (null = ainda não publicada).
  postId      String?

  @@unique([anilistId, url])
  @@index([publishedAt])
  @@index([postId])
}

/** Histórico/lock das execuções do serviço de notícias (Admin → Scrapers). */
model NewsRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | OK | PARTIAL | ERROR
  status     String
  animes     Int       @default(0)
  fetched    Int       @default(0)
  failed     Int       @default(0)
  message    String?
  adminName  String?

  @@index([startedAt])
}


/// Quiz de uma obra (Figma "20 — Quiz"): 10 perguntas aprovadas liberam a tentativa; 10/10 desbloqueia `titleReward`.
model Quiz {
  id          String         @id @default(cuid())
  /// Nulo = quiz de obra sem AniList ID (só do AniDB/Kitsu): a obra é `catalogEntryId`.
  anilistId   Int?           @unique
  catalogEntryId String?     @unique
  catalogEntry   CatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  /// Recorte do quiz, ex.: "Season 1 — personagens e ambientação".
  scope       String
  /// Título cosmético desbloqueado com 10/10, ex.: "Olhar de boticária".
  titleReward String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  /// Arquivado (Fase 9): sai do ar sem apagar perguntas, tentativas nem títulos já concedidos.
  archivedAt  DateTime?
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  titles      UserTitle[]
}

model QuizQuestion {
  id       String  @id @default(cuid())
  quizId   String
  quiz     Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// 1..10 — ordem da pergunta na tentativa.
  position Int
  /// Em caixa alta na tela, ex.: "PERSONAGENS".
  category String
  text     String
  optionA  String
  optionB  String
  optionC  String
  optionD  String
  /// 0..3 (A..D). Nunca sai da API: o gabarito não é mostrado.
  correct  Int
  /// Só perguntas aprovadas contam; com menos de 10 o quiz fica "indisponível".
  approved Boolean @default(false)

  @@unique([quizId, position])
}

/// Tentativa de uma pessoa: IN_PROGRESS → COMPLETED (ou ABANDONED). Respostas só por posição, sem gabarito.
model QuizAttempt {
  id         String    @id @default(cuid())
  quizId     String
  quiz       Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String    @default("IN_PROGRESS")
  /// Escolhas confirmadas (0..3) na ordem das posições 1..N.
  answers    Int[]     @default([])
  score      Int?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, quizId])
}

/// Título desbloqueado (conquista): persistente, independe de acompanhar a obra.
model UserTitle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, quizId])
}


/// "Adiar" (Para assistir): a pessoa adiou o episódio do dia. `fromEpisode` é o primeiro que ficou sem ver
/// ("parei no EP02"); adiar de novo um episódio mais novo não muda isso. Uma pendência por pessoa e obra.
model PendingEpisode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId   Int
  /// DESCONTINUADO (Fase 4, D5): "Adiar" vale para a OBRA, sem número de episódio. Fica só nas linhas antigas.
  fromEpisode Int?
  postponedAt DateTime @default(now())

  @@unique([userId, anilistId])
  @@index([userId])
}

/**
 * Reboot (Epic 48): `newAnilistId` refaz do zero a história de `oldAnilistId`. As duas versões ficam juntas na descrição de cada
 * uma (uma aponta a outra), mas cada linha do tempo mostra só o conteúdo da própria versão. Com `coverage` PARTIAL o reboot vai
 * além do que a versão antiga contou: a partir de `beyondFromEpisode` (do reboot) é história que a antiga nunca teve.
 */
model StoryLink {
  id                String   @id @default(cuid())
  oldAnilistId      Int
  newAnilistId      Int
  /// REBOOT (por ora o único tipo).
  kind              String   @default("REBOOT")
  /// FULL: o reboot conta a mesma história; PARTIAL: segue além do que a versão antiga cobriu.
  coverage          String   @default("FULL")
  /// Episódio do reboot a partir do qual a história passa do que a versão antiga cobriu (só PARTIAL).
  beyondFromEpisode Int?
  note              String?
  /// De onde veio a informação (endereço da lista de episódios, artigo…).
  source            String?
  /// Lote de pesquisa em que entrou.
  loot              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([oldAnilistId, newAnilistId])
  @@index([newAnilistId])
}

/** Arco de uma obra (Epic 48): faixa de episódios com nome, para a linha do tempo dos episódios sair separada por arcos. */
model StoryArc {
  id           String  @id @default(cuid())
  anilistId    Int
  /// Ordem do arco na obra (1, 2, 3…).
  position     Int
  nameEn       String
  namePt       String?
  nameJa       String?
  startEpisode Int
  endEpisode   Int
  source       String?
  loot         String?

  @@unique([anilistId, position])
  @@index([anilistId])
}

/** Par de obras que a pesquisa já conferiu (Epic 48): é o que tira o par da fila de candidatos a reboot. */
model StoryReview {
  id         String   @id @default(cuid())
  /// Sempre o menor id da AniList do par em `anilistIdA`.
  anilistIdA Int
  anilistIdB Int
  /// REBOOT ou NOT_REBOOT.
  verdict    String
  note       String?
  source     String?
  loot       String?
  reviewedAt DateTime @default(now())

  @@unique([anilistIdA, anilistIdB])
  @@index([verdict])
}

/// Histórico de alterações (Fase 2, ADR 0008): uma linha por campo alterado, com antes e depois, quem, de onde e por quê.
/// É a trilha da edição no admin, das importações seletivas e das correções de curadoria; "desfazer" lê daqui.
model ChangeLog {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  actorId        String?
  actorName      String?
  /// ADMIN | IMPORT | CURATION | JOB | SYSTEM
  origin         String
  /// CatalogEntry | Episode | Genre | Translation | Franchise …
  entity         String
  entityId       String
  /// A obra relacionada (histórico da obra no admin), quando houver.
  catalogEntryId String?
  field          String
  /// Valores em JSON (texto), para qualquer tipo de campo.
  before         String?
  after          String?
  reason         String?
  jobSeq         Int?
  batchId        String?

  @@index([entity, entityId, at])
  @@index([catalogEntryId, at])
  @@index([at])
  @@index([batchId])
}

/**
 * Comunidade do anime (estilo Orkut): o fórum de UMA franquia — todas as temporadas, OVAs e filmes juntos. A franquia é a
 * do catálogo (`CatalogEntry.franchiseKey`); obra sem franquia (só do AniDB/Kitsu) tem a comunidade dela
 * (`catalogEntryId`). Ler é público; criar tópico, responder e votar exige entrar na comunidade (`CommunityMember`).
 * Criada na primeira participação. Ver `src/lib/community.ts`.
 */
model Community {
  id             String            @id @default(cuid())
  /// Franquia (menor AniList ID do grupo, Epic 45). Pode mudar quando uma obra mais antiga entra no grupo: a busca
  /// acha a comunidade por qualquer obra da franquia e reajusta a chave.
  franchiseKey   Int?              @unique
  catalogEntryId String?           @unique
  catalogEntry   CatalogEntry?     @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  /// Descrição da comunidade (como no Orkut). Nula = a sinopse da obra principal da franquia.
  description    String?
  createdAt      DateTime          @default(now())
  members        CommunityMember[]
  topics         CommunityTopic[]
  events         CommunityEvent[]
}

model CommunityMember {
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  /// Última visita à comunidade: o que teve atividade depois disto aparece como novo em "Minhas comunidades".
  lastVisitAt DateTime  @default(now())

  @@id([communityId, userId])
  @@index([userId])
}

model CommunityTopic {
  id             String           @id @default(cuid())
  communityId    String
  community      Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId       String
  author         User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Obra (temporada, filme…) da franquia de que o tópico fala; nulo = a franquia toda.
  catalogEntryId String?
  catalogEntry   CatalogEntry?    @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  title          String
  body           String
  isSpoiler      Boolean          @default(false)
  replyCount     Int              @default(0)
  /// Criação ou última resposta: a lista de tópicos ordena por aqui.
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  editedAt       DateTime?
  /// Apagado pelo autor ou removido pela equipe: some da lista, as respostas ficam guardadas.
  deletedAt      DateTime?
  /// Fixado pela moderação: fica no topo do fórum.
  pinnedAt       DateTime?
  /// Trancado pela moderação: continua visível, mas não aceita respostas nem votos.
  lockedAt       DateTime?
  replies        CommunityReply[]
  poll           CommunityPoll?
  reports        CommunityReport[]

  @@index([communityId, deletedAt, lastActivityAt])
  @@index([authorId])
}

model CommunityReply {
  id        String         @id @default(cuid())
  topicId   String
  topic     CommunityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  isSpoiler Boolean        @default(false)
  createdAt DateTime       @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  reports   CommunityReport[]

  @@index([topicId, createdAt])
  @@index([authorId])
}

/// Enquete de um tópico: 2 a 10 opções, um voto por pessoa (sem trocar), resultado visível a todos.
model CommunityPoll {
  id      String                @id @default(cuid())
  topicId String                @unique
  topic   CommunityTopic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options CommunityPollOption[]
  votes   CommunityPollVote[]
}

model CommunityPollOption {
  id       String              @id @default(cuid())
  pollId   String
  poll     CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  position Int
  label    String
  votes    CommunityPollVote[]

  @@unique([pollId, position])
}

model CommunityPollVote {
  pollId   String
  poll     CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId   String
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId String
  option   CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  votedAt  DateTime            @default(now())

  @@id([pollId, userId])
  @@index([optionId])
}

/// Evento da comunidade (maratona, estreia, encontro…), como no Orkut: data, descrição e quem vai.
model CommunityEvent {
  id          String               @id @default(cuid())
  communityId String
  community   Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  /// Onde: texto livre ou um link (sala de chat, transmissão…).
  place       String?
  createdAt   DateTime             @default(now())
  deletedAt   DateTime?
  rsvps       CommunityEventRsvp[]

  @@index([communityId, deletedAt, startsAt])
}

model CommunityEventRsvp {
  eventId   String
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// GOING (vou) | MAYBE (talvez)
  status    String
  createdAt DateTime       @default(now())

  @@id([eventId, userId])
}

/// Denúncia de tópico ou resposta da comunidade: vai para a fila de Acesso e moderação.
model CommunityReport {
  id           String          @id @default(cuid())
  reporterId   String
  reporter     User            @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  topicId      String?
  topic        CommunityTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  replyId      String?
  reply        CommunityReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?           @relation("CommunityReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  /// REMOVED (conteúdo removido) | KEPT (mantido)
  action       String?

  @@unique([reporterId, topicId, replyId])
  @@index([resolvedAt])
}

/// Recado (scrap) no perfil, como no Orkut: qualquer conta deixa um recado no perfil de outra pessoa (sem bloqueio entre
/// as duas). Quem recebeu e quem escreveu podem apagar.
model Scrap {
  id        String    @id @default(cuid())
  profileId String
  profile   User      @relation("ScrapProfile", fields: [profileId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("ScrapAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([profileId, deletedAt, createdAt])
}

/// Depoimento: um amigo (seguir mútuo) escreve sobre a pessoa; só aparece depois que ela aprova. Um por amigo (editar volta
/// para a aprovação).
model Testimonial {
  id         String    @id @default(cuid())
  profileId  String
  profile    User      @relation("TestimonialProfile", fields: [profileId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation("TestimonialAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  /// PENDING | APPROVED | REJECTED
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  decidedAt  DateTime?

  @@unique([profileId, authorId])
  @@index([profileId, status])
}

/// "Ser fã" de alguém (como no Orkut).
model Fan {
  fanId     String
  fan       User     @relation("FanOf", fields: [fanId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("FanTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([fanId, targetId])
  @@index([targetId])
}

/// Avaliação de um amigo (como o confiável/legal/sexy do Orkut, com o tema do Anime Hub): Otaku raiz, Gente boa e Sem
/// spoiler, de 0 a 3 cada. Só amigos (seguir mútuo) avaliam; o perfil mostra a média.
model ProfileRating {
  raterId    String
  rater      User     @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  targetId   String
  target     User     @relation("RatingTarget", fields: [targetId], references: [id], onDelete: Cascade)
  otaku      Int      @default(0)
  gentil     Int      @default(0)
  semSpoiler Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([raterId, targetId])
  @@index([targetId])
}

/// Amizade (como no Orkut), separada do seguir: nasce de um pedido aceito. Um registro por par, com `userAId` < `userBId`
/// (ordem dos ids), para não haver duplicata. Depoimentos e avaliações exigem amizade.
model Friendship {
  userAId   String
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userAId, userBId])
  @@index([userBId])
}

/// Pedido de amizade pendente. Aceitar cria a `Friendship` e apaga o pedido; recusar ou cancelar só apaga.
model FriendRequest {
  fromId    String
  from      User     @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([fromId, toId])
  @@index([toId])
}
