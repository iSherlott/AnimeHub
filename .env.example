ANIME_HUB_DATABASE_URL="file:./dev.db"

# Fonte gratuita de episódios/imagens/títulos JP, usada como cache — dados
# obtidos são salvos no banco (tabela Episode + Anime.titleNative/coverImage)
# para continuar funcionando se a API sair do ar.
KITSU_API_BASE_URL="https://kitsu.io/api/edge"

# Opcionais — só precisam ser definidas se quiser trocar o endpoint padrão
# (ex.: um mirror, ou apontar pra um mock local em teste). Sem elas, o
# código já usa os valores abaixo como padrão.
# JIKAN_API_BASE_URL="https://api.jikan.moe/v4"
# SHIKIMORI_API_BASE_URL="https://shikimori.one/api"

# Opcional — AniDB tem o banco de títulos multilíngues mais completo (às
# vezes até título oficial em português) e dados que nenhuma outra fonte
# tem (prêmios, links pra outros bancos). A API HTTP deles exige um client
# registrado na sua conta em anidb.net (Settings → HTTP API). Sem isso
# preenchido, o botão "Atualizar dados" simplesmente pula essa fonte.
# ANIDB_CLIENT_NAME="seunomedeclient"
# ANIDB_CLIENT_VERSION="1"

# Modo de teste "só AniDB" — quando "true", desativa temporariamente
# AniList/Kitsu/Jikan/Shikimori (refresh, calendário, busca e episódios
# passam a depender só do cache local + AniDB). Deixe "false" ou omitida
# em uso normal.
# DISABLE_OTHER_SOURCES="false"
