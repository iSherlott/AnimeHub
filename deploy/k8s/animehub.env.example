# Copie para deploy/k8s/animehub.env (fica fora do git e das imagens) e preencha. Vira o Secret "animehub-env",
# lido por todos os pods (site, serviços e migração).

# Banco no notebook (schema animehub do datatrade). Dentro do cluster, prefira o nome DNS do Service do Postgres
# (passo 3 do README): postgresql://USUARIO:SENHA@<service>.<namespace>.svc.cluster.local:<porta>/datatrade?schema=animehub&sslmode=disable
ANIME_HUB_DATABASE_URL=postgresql://USUARIO:SENHA@192.168.1.69:31100/datatrade?schema=animehub&sslmode=disable

# Login por HTTP (sem HTTPS na frente): sem isto o navegador não guarda o cookie de sessão em produção.
SESSION_COOKIE_SECURE=false

# Fuso do servidor: os pods nascem em UTC, e o que é montado no servidor (datas de comentário, "Atualizado em", a semana
# do calendário quando o navegador não manda a dele) sairia 3 h adiantado. O padrão do produto é o de São Paulo.
TZ=America/Sao_Paulo

# Fontes externas.
KITSU_API_BASE_URL=https://kitsu.io/api/edge
DISABLE_OTHER_SOURCES=false
# ANIDB_CLIENT_NAME=
# ANIDB_CLIENT_VERSION=
# Intervalo entre consultas ao AniDB no lote de episódios (ms; padrão 4000, não baixe de 2000)
# ANIDB_REQUEST_GAP_MS=4000

# Serviços de fundo (nomes dos Services do Kubernetes; não mude).
CACHE_UPDATER_URL=http://cache-updater:4003
NAME_RESOLVER_URL=http://name-resolver:4002
NEWS_FETCHER_URL=http://news-fetcher:4005

# Tradução das sinopses (Deployment libretranslate.yaml). Sem ele, comente a linha: o site usa o MyMemory gratuito.
LIBRETRANSLATE_URL=http://libretranslate:5000
TRANSLATION_CONCURRENCY=6
